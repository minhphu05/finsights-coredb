Project finsights_auth {
  database_type: 'MySQL'
  Note: 'Node 2 · Backend user and admin authentication accounts and transactional outbox.'
}

Table admin_accounts {
  id bigint [pk, increment, not null]
  username varchar(64) [not null, unique]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  failed_login_attempts int [not null, default: 0]
  locked_until datetime(3)
  last_login_at datetime(3)
  created_by_admin_id bigint [ref: > admin_accounts.id]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]

  Indexes {
    (is_active, username)
  }
}

Table accounts {
  id bigint [pk, increment, not null]
  email varchar(254) [not null, unique]
  password_hash varchar(255) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
}

Table auth_google_identities {
  id bigint [pk, increment, not null]
  provider varchar(32) [not null, default: 'google']
  provider_subject varchar(255) [not null]
  account_id bigint [not null, ref: > accounts.id]
  email varchar(254) [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  Indexes {
    (provider, provider_subject) [unique]
    (account_id, provider) [unique]
    (email)
  }
}

Table outbox_events {
  id bigint [pk, increment, not null]
  event_id varchar(64) [not null, unique]
  event_type varchar(120) [not null]
  payload json [not null]
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  published_at datetime(3)
  Indexes {
    (published_at, id)
  }
}
