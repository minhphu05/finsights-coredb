# Local PostgreSQL route through the Finsights Node 1 NodePort.
POSTGRES_ADMIN_PASSWORD=replace-me
DAGSTER_DB_PASSWORD=replace-me
POSTGRES_HOST=100.96.150.92
POSTGRES_PORT=30432

# MySQL administrator and application passwords. Keep the two administrator
# passwords separate. Node 1 hosts AI and collection data; Node 2 hosts backend DBs.
MYSQL_NODE_1_ADMIN_PASSWORD=replace-me
MYSQL_NODE_2_ADMIN_PASSWORD=replace-me

# Backend database accounts on Node 2 and collection accounts on Node 1.
MYSQL_ASSETS_APP_PASSWORD=replace-me
MYSQL_AUTH_APP_PASSWORD=replace-me
MYSQL_MARKET_APP_PASSWORD=replace-me
MYSQL_NEWS_APP_PASSWORD=replace-me
MYSQL_SCRAPING_APP_PASSWORD=replace-me
MYSQL_USER_APP_PASSWORD=replace-me

# Tokyo AI chat-history account password.
MYSQL_AI_APP_PASSWORD=replace-me
